<?xml version="1.0" encoding="UTF-8"?>
<!-- ==========================================================================
     beans.xml — the marker file that says "CDI, look in this archive".

     Nothing in Practical 1 strictly needs it: our beans are enterprise beans,
     and those are discovered with or without this file. It is here because
     Practical 2 is built on CDI, and because an empty beans.xml is the most
     common file in every Jakarta EE project. No harm, no cost.

     bean-discovery-mode="all" means "treat every class as a candidate bean".
     A one-line file is perfectly valid — the version and schema attributes are
     the only required content.
     ========================================================================== -->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="all">
</beans>
